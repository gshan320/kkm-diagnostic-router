# Copy to backend/.env. Every setting has a working default — this file is
# entirely optional. There is no API key: generation runs on a local MLX model.

# Local MLX model (Apple Silicon). Weights are pulled from Hugging Face on the
# first request and cached under ~/.cache/huggingface; inference is offline.
LOCAL_MLX_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# Generation caps
MAX_TOKENS_TRIAGE=4000
MAX_TOKENS_INQUIRY=32000

# all-MiniLM-L6-v2 truncates input at 256 tokens. The Phase 1 spec asks for
# 500-token chunks; set this to 256 if you want every token of every chunk to
# actually influence its embedding vector. See README "Chunk size caveat".
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Mode A retrieval depth (triage / clinical / formulary sub-retrievals)
TRIAGE_K=8
CPG_K=10
DRUG_K=8

# CORS origins for the Next.js dev server
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
